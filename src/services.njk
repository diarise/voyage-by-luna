---
layout: base.njk
title: "Travel Services"
description: "Disney vacations, cruises, all-inclusive resorts, and the activities and experiences that make a trip - planned by a personal travel advisor."
permalink: "/services/"
---
<section class="page-hero">
  <div class="wrap">
    <h1>{{ services.heading }}</h1>
    <p class="lead">{{ services.intro }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {% for cat in services.categories %}
    <div class="service-detail {% if loop.index0 is even %}service-detail-reverse{% endif %}" id="{{ cat.id }}">
      <div class="service-detail-icon-wrap">
        <span class="service-icon icon-{{ cat.icon }} icon-lg" aria-hidden="true"></span>
      </div>
      <div class="service-detail-copy">
        {% if cat.image %}
        <div class="service-detail-media"><img src="{{ cat.image }}" alt="" loading="lazy"></div>
        {% endif %}
        <h2>{{ cat.title }}</h2>
        <p class="service-who">{{ cat.who }}</p>
        <p class="lead">{{ cat.body }}</p>
        <a href="/contact/?trip={{ cat.id }}" class="btn btn-primary">{{ cat.cta_label }}</a>
        {%- set selfServe = ([cat.self_serve] | partnersFor(affiliatePartners.partners)) if cat.self_serve else [] %}
        {% if selfServe.length %}
        <p class="service-selfserve">Prefer to browse on your own? <a href="{{ selfServe[0].url }}" target="_blank" rel="sponsored nofollow noopener">Explore tours and activities on {{ selfServe[0].name }}<span class="sr-only"> (opens in a new tab)</span></a></p>
        <p class="service-selfserve-note">Affiliate link — Voyage By Luna may earn a commission at no extra cost to you.</p>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section final-cta">
  <div class="wrap final-cta-inner">
    <h2>Not sure which fits? Let's talk it through.</h2>
    <p class="lead">Tell me a bit about what you're picturing and I'll point you in the right direction.</p>
    <a href="/contact/" class="btn btn-primary btn-lg">Plan My Trip</a>
  </div>
</section>
