---
layout: base.njk
title: "Cruises, Resorts & Disney Vacations"
description: "Soukeyna Traoré-Dia is a personal travel advisor planning cruises, all-inclusive resorts, Disney vacations and destination weddings — one point of contact, start to finish."
---
<section class="hero">
  <div class="hero-media{% if not home.hero_image %} hero-media-empty{% endif %}">
    {% if home.hero_image %}<img src="{{ home.hero_image }}" alt="" fetchpriority="high" width="1600" height="847">{% endif %}
  </div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{{ home.hero_eyebrow }}</p>
      <h1>{{ home.hero_heading }}</h1>
      <p class="lead">{{ home.hero_subheading }}</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary btn-lg">{{ home.hero_cta_label }}</a>
        <a href="/services/" class="btn btn-ghost-light btn-lg">{{ home.hero_secondary_cta_label }}</a>
      </div>
    </div>
  </div>
  <div class="hero-strip">
    <div class="wrap hero-strip-inner">
      {% for item in home.hero_strip %}
      <span class="hero-strip-item">{{ item }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section why-advisor">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">Why an advisor</p>
      <h2>{{ home.why_advisor_heading }}</h2>
      <p class="lead">{{ home.why_advisor_body }}</p>
    </div>
    <div class="grid-3">
      {% for point in home.why_advisor_points %}
      <div class="point-card">
        <span class="point-num" aria-hidden="true">{{ loop.index }}</span>
        <h3>{{ point.title }}</h3>
        <p>{{ point.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section services-preview" id="services">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">What I plan</p>
      <h2>{{ home.services_heading }}</h2>
      <p class="lead">{{ home.services_subheading }}</p>
    </div>
    <div class="grid-4">
      {% for cat in services.categories %}
      <a class="service-card{% if cat.image %} service-card-has-media{% endif %}" href="/services/#{{ cat.id }}">
        {% if cat.image %}
        <div class="service-card-media"><img src="{{ cat.image }}" alt="" loading="lazy"></div>
        {% else %}
        <span class="service-icon icon-{{ cat.icon }}" aria-hidden="true"></span>
        {% endif %}
        <h3>{{ cat.title }}</h3>
        <p class="service-for">{{ cat.who }}</p>
        <span class="card-link">See how it works <span aria-hidden="true">&rarr;</span></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section how-it-works">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>{{ home.process_heading }}</h2>
      <p class="lead">{{ home.process_body }}</p>
    </div>
    <ol class="process-list">
      {% for step in home.process_steps %}
      <li class="process-step">
        <span class="process-num" aria-hidden="true">{{ loop.index }}</span>
        <div>
          <h3>{{ step.title }}</h3>
          <p>{{ step.body }}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
    <div class="process-cta">
      <a href="/contact/" class="btn btn-primary btn-lg">{{ home.process_cta_label }}</a>
    </div>
  </div>
</section>

{% if collections.destinations.length %}
<section class="section destinations" id="destinations">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">Inspiration</p>
      <h2>{{ home.destinations_heading }}</h2>
      <p class="lead">{{ home.destinations_subheading }}</p>
    </div>
    <div class="destination-grid">
      {% for dest in collections.destinations | sort(false, false, "data.order") %}
      {% if loop.index <= 6 %}
      <a class="destination-card" href="{{ dest.data.link or '/contact/?trip=other' }}">
        <div class="destination-media{% if not dest.data.image %} destination-media-empty{% endif %}">
          {% if dest.data.image %}<img src="{{ dest.data.image }}" alt="{{ dest.data.title }}" loading="lazy">{% endif %}
        </div>
        <div class="destination-card-body">
          {% if dest.data.kicker %}<span class="destination-kicker">{{ dest.data.kicker }}</span>{% endif %}
          <h3>{{ dest.data.title }}</h3>
          <div class="destination-desc">{{ dest.templateContent | safe }}</div>
        </div>
      </a>
      {% endif %}
      {% endfor %}
    </div>
    <div class="section-foot">
      <a href="/destinations/" class="btn btn-outline">See all destinations</a>
    </div>
  </div>
</section>
{% endif %}

<section class="section advisor-intro">
  <div class="wrap advisor-grid">
    <div class="advisor-photo">
      {% if about.image %}
      <img src="{{ about.image }}" alt="{{ about.image_alt }}" loading="lazy">
      {% else %}
      {# Branded stand-in until a real photo of Soukeyna is uploaded in the CMS #}
      <div class="photo-placeholder" aria-hidden="true"><img src="/images/logo-mark.png" alt="" width="110" height="73" loading="lazy"></div>
      {% endif %}
    </div>
    <div class="advisor-copy">
      <p class="eyebrow eyebrow-dark">Who you'll be working with</p>
      <h2>{{ home.advisor_heading }}</h2>
      <p class="lead">{{ home.advisor_body }}</p>
      <a href="/about/" class="btn btn-outline">More about Soukeyna</a>
    </div>
  </div>
</section>

{% if collections.testimonials.length %}
<section class="section testimonials">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow eyebrow-dark">In their words</p>
      <h2>What clients say</h2>
    </div>
    <div class="grid-3">
      {% for t in collections.testimonials | sort(false, false, "data.order") %}
      <blockquote class="testimonial-card">
        <div class="testimonial-quote">{{ t.templateContent | safe }}</div>
        <cite>{{ t.data.name }}{% if t.data.trip %} <span>— {{ t.data.trip }}</span>{% endif %}</cite>
      </blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ---- Book it yourself: every enabled partner from src/_data/affiliatePartners.json, by category ---- #}
<section class="section partners-home" id="travel-partners" aria-labelledby="partners-title">
  <div class="wrap">
    <div class="partners-home-head">
      <div class="partners-home-intro">
        <p class="eyebrow eyebrow-dark">{{ home.partners_eyebrow }}</p>
        <h2 id="partners-title">{{ home.partners_heading }}</h2>
        <p class="lead">{{ home.partners_body }}</p>
      </div>
      <div class="partners-home-advisor">
        <p class="partners-home-advisor-title">{{ home.partners_advisor_heading }}</p>
        <p>{{ home.partners_advisor_body }}</p>
        <a href="/contact/" class="btn btn-primary">{{ home.partners_advisor_label }}</a>
      </div>
    </div>
    <div class="partner-cats">
      {% for c in affiliatePartners.categories %}
      {% set catPartners = affiliatePartners.partners | partnersInCategory(c.id) %}
      {% if catPartners.length %}
      <div class="partner-cat">
        <h3 class="partner-cat-title">{{ c.name }}</h3>
        <ul class="partner-list">
          {% for p in catPartners %}
          <li>
            <a class="partner-link" href="{{ p.url }}" target="_blank" rel="sponsored nofollow noopener">
              <span class="partner-name">{{ p.name }}</span>
              <span class="partner-books">{{ p.books }}</span>
              <span class="partner-go">Explore <span aria-hidden="true">&#8599;</span><span class="sr-only"> (opens in a new tab)</span></span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    <p class="affiliate-note partners-disclosure">{{ home.partners_disclosure }}</p>
  </div>
</section>

<section class="section final-cta">
  <div class="wrap final-cta-inner">
    <h2>{{ home.final_cta_heading }}</h2>
    <p class="lead">{{ home.final_cta_body }}</p>
    <div class="final-cta-actions">
      <a href="/contact/" class="btn btn-primary btn-lg">{{ home.final_cta_label }}</a>
      <a href="{{ site.phone_link }}" class="btn btn-ghost-light btn-lg">Or call {{ site.phone }}</a>
    </div>
  </div>
</section>
