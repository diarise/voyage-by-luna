---
eleventyExcludeFromCollections: true
---
{#- Public pre-launch page. Only built while the launch gate is on (src/_data/launch.json).
    Netlify serves it at "/" (see src/redirects.njk); it has no navigation on purpose. -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.business_name }} — Our New Website Is Coming Soon</title>
  <meta name="description" content="{{ site.business_name }} is putting the finishing touches on a new website. Travel planning with {{ site.advisor_name }} continues as usual.">
  <link rel="canonical" href="https://voyagebyluna.com/">
  <link rel="icon" href="/images/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#012F6D">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.business_name }}">
  <meta property="og:title" content="{{ site.business_name }} — New Website Coming Soon">
  <meta property="og:description" content="We're putting the finishing touches on a better way to plan your next journey.">
  <meta property="og:url" content="https://voyagebyluna.com/">
  <meta property="og:image" content="https://voyagebyluna.com/images/logo-full.png">
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap">
  <style>
    :root { --navy: #012F6D; --navy-deep: #011E48; --blue: #0055A8; --gold: #FFD21F; }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center;
      padding: 48px 22px; color: #fff; text-align: center;
      font: 400 17px/1.65 "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 82% 16%, rgba(255,210,31,.95) 0 52px, rgba(255,210,31,.16) 54px, rgba(255,210,31,0) 150px),
        linear-gradient(155deg, var(--navy-deep) 0%, var(--navy) 55%, #033f8c 100%);
      background-attachment: fixed;
    }
    main { max-width: 620px; }
    .eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: .74rem; font-weight: 600; color: var(--gold); margin: 0 0 14px; }
    h1 { font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: clamp(2.1rem, 6vw, 3.4rem); line-height: 1.1; letter-spacing: -.015em; margin: 0 0 18px; }
    p { margin: 0 0 14px; color: rgba(255,255,255,.86); font-size: clamp(1.02rem, 2.2vw, 1.14rem); }
    .rule { width: 56px; height: 2px; background: var(--gold); border: 0; margin: 30px auto; }
    .contact { font-size: .98rem; }
    .contact a { color: var(--gold); font-weight: 600; text-decoration: none; border-bottom: 1px solid rgba(255,210,31,.5); }
    .contact a:hover, .contact a:focus-visible { border-bottom-color: var(--gold); }
    a:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 2px; }
    @media (max-width: 600px) {
      body { background:
        radial-gradient(circle at 92% 5%, rgba(255,210,31,.95) 0 28px, rgba(255,210,31,.14) 30px, rgba(255,210,31,0) 84px),
        linear-gradient(155deg, var(--navy-deep) 0%, var(--navy) 55%, #033f8c 100%); }
    }
    footer { margin-top: 42px; font-size: .82rem; color: rgba(255,255,255,.55); }
  </style>
</head>
<body>
  {# Netlify Identity invite / password-reset links land on "/" with a token in the hash. #}
  <script>
    if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
      location.replace('/admin/' + location.hash);
    }
  </script>
  <main>
    <p class="eyebrow">A new look is on its way</p>
    <h1>Our new website is coming soon.</h1>
    <p>We're putting the finishing touches on a better way to plan your next journey.</p>
    <hr class="rule">
    <p class="contact">Planning a trip in the meantime? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <footer>&copy; 2022&ndash;{{ currentYear }} {{ site.business_name }}</footer>
  </main>
</body>
</html>
