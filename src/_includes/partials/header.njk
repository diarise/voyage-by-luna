<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="{{ site.business_name }} home">
      <img src="/images/logo.png" alt="{{ site.business_name }} logo" width="44" height="44">
      <span>{{ site.business_name }}</span>
    </a>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="siteNav">
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      <a href="/contact/" class="btn btn-primary btn-nav-cta">Plan Your Trip</a>
    </nav>
  </div>
</header>
