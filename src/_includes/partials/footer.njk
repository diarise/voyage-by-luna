<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/images/logo-full.png" alt="{{ site.business_name }}" width="260" height="182" loading="lazy">
      <p class="footer-role">{{ site.advisor_name }} — {{ site.advisor_role }}</p>
      <p class="footer-tagline">{{ site.tagline }}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-head">Contact</h2>
      <p><a href="{{ site.phone_link }}">{{ site.phone }}</a></p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>

    <div class="footer-col">
      <h2 class="footer-head">Explore</h2>
      <ul class="footer-links">
        <li><a href="/about/">About Soukeyna</a></li>
        <li><a href="/services/">Travel Services</a></li>
        <li><a href="/destinations/">Destinations</a></li>
        <li><a href="{{ site.blog_url }}">Travel Blog</a></li>
        <li><a href="/contact/">Plan Your Trip</a></li>
        <li><a href="/#travel-partners">Travel Partners</a></li>
        <li><a href="/join-our-team/">Join Our Team</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-head">Follow</h2>
      <ul class="social-links">
        {% if site.social.instagram %}<li><a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/></svg></a></li>{% endif %}
        {% if site.social.facebook %}<li><a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M14 8V6.5c0-.83.67-1.5 1.5-1.5H17V2h-2.5A4.5 4.5 0 0 0 10 6.5V8H7.5v3H10v11h4V11h2.6l.4-3z"/></svg></a></li>{% endif %}
        {% if site.social.pinterest %}<li><a href="{{ site.social.pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.64 19.31c-.09-.79-.17-2 .04-2.86l1.23-5.2s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.57 2.25-.87 3.5-.25 1.05.53 1.9 1.56 1.9 1.87 0 3.31-1.97 3.31-4.82 0-2.52-1.81-4.28-4.4-4.28-3 0-4.76 2.25-4.76 4.57 0 .9.35 1.88.79 2.41a.32.32 0 0 1 .07.31l-.29 1.2c-.05.19-.15.23-.35.14-1.31-.61-2.13-2.53-2.13-4.07 0-3.32 2.41-6.36 6.94-6.36 3.64 0 6.47 2.6 6.47 6.06 0 3.62-2.28 6.53-5.45 6.53-1.06 0-2.07-.55-2.41-1.21l-.66 2.5c-.24.91-.88 2.06-1.31 2.75A10 10 0 1 0 12 2z"/></svg></a></li>{% endif %}
        {% if site.social.linkedin %}<li><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="3" y="9" width="4" height="12" fill="currentColor"/><circle cx="5" cy="4.8" r="2.2" fill="currentColor"/><path fill="currentColor" d="M10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H10z"/></svg></a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {{ currentYear }} {{ site.business_name }}. All rights reserved.</p>
  </div>
</footer>
