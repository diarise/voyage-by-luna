<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo_title or title }} | {{ site.business_name }}</title>
  <meta name="description" content="{{ description }}">
  {% if launchGate.active or launchGate.previewBypass %}<meta name="robots" content="noindex,nofollow">{% elif noindex %}<meta name="robots" content="noindex">{% endif %}

  {# Canonical host must match the host the site is actually served from.
     Pages that ask not to be indexed don't also declare a canonical (mixed signals). #}
  {% if not noindex %}<link rel="canonical" href="https://voyagebyluna.com{{ page.url }}">{% endif %}

  <link rel="icon" href="/images/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#012F6D">

  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:site_name" content="{{ site.business_name }}">
  <meta property="og:title" content="{{ seo_title or title }} | {{ site.business_name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://voyagebyluna.com{{ og_image or home.hero_image or '/images/logo-full.png' }}">
  <meta property="og:url" content="https://voyagebyluna.com{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@voyagebyluna">
  <link rel="alternate" type="application/atom+xml" title="{{ site.business_name }} Journal" href="/blog/feed.xml">
  {% if og_type == "article" %}{% include "partials/article-meta.njk" %}{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {# Web fonts load without blocking the first paint (text shows in the fallback font first). #}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"></noscript>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  {# Netlify Identity invite / password-reset emails link to the homepage with a
     token in the URL hash. Send those straight to the CMS, which handles them. #}
  <script>
    if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
      location.replace('/admin/' + location.hash);
    }
  </script>
  <a href="#main" class="skip-link">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/mobile-cta.njk" %}

  <script src="/js/main.js" defer></script>

  {% include "partials/schema.njk" %}
</body>
</html>
